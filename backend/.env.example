# Хуулж .env болгоно. Утгыг git-д БҮҮ commit хий.

NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:3000"

# --- mn-integrations (шаардлагатай үед) ---
# KB_BASE_URL=
# KB_USERNAME=
# KB_PASSWORD=
# BONUM_API_BASE_URL=
# BONUM_APP_SECRET=
# BONUM_TERMINAL_ID=
# BONUM_MERCHANT_CHECKSUM_KEY=
# COSO_SMS_BASE_URL=
# COSO_SMS_API_KEY=
# COSO_SMS_FROM=

# --- Үе шат 2: Auth ---
# docker compose up -d (docker-compose.yml)
DATABASE_URL="postgresql://starter:starter@localhost:5433/uizeniveelt?schema=public"
# openssl rand -base64 32
SESSION_SECRET="ЭНД-32-ААС-УРТ-САНАМСАРГҮЙ-МӨР-ТАВЬ--------"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"
SESSION_TTL_SECONDS="604800"

# --- И-мэйл (docker compose: Mailpit, UI http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
MAIL_FROM="Starter <no-reply@example.mn>"
APP_URL="http://localhost:3000"

# --- Файл хадгалалт (docker compose: MinIO, консол http://localhost:9001) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="starter"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://localhost:9000/starter"
