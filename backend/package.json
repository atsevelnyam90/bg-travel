{
  "name": "@winu/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && prisma migrate deploy && prisma generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:skip-db": "pnpm build:packages && tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:infra": "docker compose up -d && pnpm build:packages && prisma migrate deploy && prisma generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "pnpm build:packages && tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build:packages": "pnpm --recursive --filter \"./packages/*\" --if-present build",
    "typecheck": "pnpm build:packages && tsc --noEmit && pnpm --recursive --filter \"./packages/*\" typecheck",
    "test": "vitest",
    "test:run": "vitest --run --passWithNoTests && pnpm --recursive --filter \"./packages/*\" test:run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:boundaries": "node ../scripts/check-boundaries.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:prepare": "prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:test:setup": "node --env-file-if-exists=.env scripts/setup-test-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@winu/contracts": "workspace:*",
    "@winu/mn-integrations": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
