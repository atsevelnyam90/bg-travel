{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@winu/contracts": ["./packages/contracts/src/index.ts"],
      "@winu/mn-integrations": ["./packages/mn-integrations/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"]
}
