{
  "name": "@winu/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:packages && next dev",
    "build": "pnpm build:packages && next build",
    "build:mobile": "pnpm build:packages && CAPACITOR_BUILD=true next build",
    "build:cap:android": "node scripts/build-capacitor.js android production remote",
    "build:cap:android:packaged": "node scripts/build-capacitor.js android production packaged",
    "build:cap:android:dev": "node scripts/build-capacitor.js android staging remote",
    "build:cap:android:dev:packaged": "node scripts/build-capacitor.js android staging packaged",
    "build:cap:ios": "node scripts/build-capacitor.js ios production remote",
    "build:cap:ios:packaged": "node scripts/build-capacitor.js ios production packaged",
    "build:cap:ios:dev": "node scripts/build-capacitor.js ios staging remote",
    "build:cap:ios:dev:packaged": "node scripts/build-capacitor.js ios staging packaged",
    "sync:cap:android:local": "node scripts/build-capacitor.js android local",
    "sync:cap:ios:local": "node scripts/build-capacitor.js ios local",
    "build:android-debug": "pnpm run build:cap:android && cd android && ./gradlew assembleDebug",
    "build:android-debug:packaged": "pnpm run build:cap:android:packaged && cd android && ./gradlew assembleDebug",
    "build:androidrelease": "pnpm run build:cap:android && cd android && ./gradlew bundleRelease",
    "build:androidrelease:packaged": "pnpm run build:cap:android:packaged && cd android && ./gradlew bundleRelease",
    "start": "next start",
    "build:packages": "pnpm --recursive --filter \"./packages/*\" --if-present build",
    "check:boundaries": "node ../scripts/check-boundaries.mjs",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest",
    "test:run": "vitest --run --passWithNoTests",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@duke333/builder-ui": "0.2.5",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/table-core": "9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
